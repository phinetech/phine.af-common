#!/bin/bash

# Install nghttp2 with ASIO bindings from source
# Install nghttp2 with ASIO bindings from source
install_nghttp2_from_git() {
    local force=$1
    local debug=$2
    
    echo "Installing nghttp2 with ASIO bindings from source"
    
    # Always force rebuild for this run
    force=1
    
    # Check if nghttp2 is already installed and we're not forcing
    if [ $force -eq 0 ]; then
        if [ -d "/usr/local/include/nghttp2" ] && [ -f "/usr/local/lib/libnghttp2_asio.so" ]; then
            echo "nghttp2 with ASIO bindings already installed"
            return 0
        fi
    fi
    
    # Install dependencies
    if [[ $OS_DISTRO == "ubuntu" ]]; then
        $SUDO $INSTALLER install -y g++ make binutils autoconf automake autotools-dev libtool pkg-config \
                                  zlib1g-dev libcunit1-dev libssl-dev libxml2-dev libev-dev libevent-dev libjansson-dev \
                                  libc-ares-dev libboost-dev libboost-system-dev libboost-thread-dev
    elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
        $SUDO $INSTALLER install -y gcc-c++ make binutils autoconf automake libtool pkgconfig \
                                  zlib-devel CUnit-devel openssl-devel libxml2-devel libev-devel libevent-devel jansson-devel \
                                  c-ares-devel boost-devel
    fi
    check_command_failure "Installing nghttp2 dependencies"
    
    # Get OpenSSL installation path
    OPENSSL_ROOT_DIR=$(dirname $(dirname $(which openssl)))
    if [ -z "$OPENSSL_ROOT_DIR" ]; then
        OPENSSL_ROOT_DIR="/usr"
    fi
    echo "Using OpenSSL from: $OPENSSL_ROOT_DIR"
    
    # Create a temporary directory
    local tmp_dir=$(mktemp -d)
    cd $tmp_dir
    
    # Clone the repository
    git clone https://github.com/nghttp2/nghttp2.git
    check_command_failure "Cloning nghttp2 repository"
    
    cd nghttp2
    git checkout v1.65.0
    
    # Clean up any previous build artifacts
    if [ -d "build" ]; then
        rm -rf build
    fi
    
    # Build and install
    autoreconf -i
    check_command_failure "Running autoreconf for nghttp2"
    
    # Configure with explicit OpenSSL paths
    PKG_CONFIG_PATH="$OPENSSL_ROOT_DIR/lib/pkgconfig:$PKG_CONFIG_PATH" \
    CPPFLAGS="-I$OPENSSL_ROOT_DIR/include" \
    LDFLAGS="-L$OPENSSL_ROOT_DIR/lib -Wl,-rpath,$OPENSSL_ROOT_DIR/lib" \
    # ./configure --enable-asio-lib --with-boost=/usr --with-openssl=$OPENSSL_ROOT_DIR --enable-lib-only
    ./configure --enable-lib-only
    check_command_failure "Configuring nghttp2"
    
    make -j$(nproc)
    check_command_failure "Building nghttp2"
    
    # First uninstall any previous version
    $SUDO make uninstall || true
    
    $SUDO make install
    check_command_failure "Installing nghttp2"
    
    $SUDO ldconfig
    
    # Create symlinks if needed
    if [ ! -f "/usr/lib/libnghttp2.so" ] && [ -f "/usr/local/lib/libnghttp2.so" ]; then
        echo "Creating symlinks for nghttp2 libraries"
        $SUDO ln -sf /usr/local/lib/libnghttp2.so /usr/lib/libnghttp2.so
        # $SUDO ln -sf /usr/local/lib/libnghttp2_asio.so /usr/lib/libnghttp2_asio.so
    fi
    
    # Clean up
    cd $THIS_SCRIPT_PATH
    echo "================= Cleaning up temporary directory $tmp_dir"
    rm -rf $tmp_dir
    
    echo "nghttp2 with ASIO bindings installation complete"
    return 0
}

install_nghttp2_asio_from_git() {
    local force=$1
    local debug=$2
    
    echo "Installing nghttp2 with ASIO bindings from source"
    
    # Always force rebuild for this run
    force=1
    
    # Check if nghttp2 is already installed and we're not forcing
    if [ $force -eq 0 ]; then
        if [ -d "/usr/local/include/nghttp2" ] && [ -f "/usr/local/lib/libnghttp2_asio.so" ]; then
            echo "nghttp2 with ASIO bindings already installed"
            return 0
        fi
    fi
    
    # Install dependencies
    if [[ $OS_DISTRO == "ubuntu" ]]; then
        $SUDO $INSTALLER install -y g++ make binutils autoconf automake autotools-dev libtool pkg-config \
                                  zlib1g-dev libcunit1-dev libssl-dev libxml2-dev libev-dev libevent-dev libjansson-dev \
                                  libc-ares-dev libboost-dev libboost-system-dev libboost-thread-dev
    elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
        $SUDO $INSTALLER install -y gcc-c++ make binutils autoconf automake libtool pkgconfig \
                                  zlib-devel CUnit-devel openssl-devel libxml2-devel libev-devel libevent-devel jansson-devel \
                                  c-ares-devel boost-devel
    fi
    check_command_failure "Installing nghttp2 dependencies"
    
    # Get OpenSSL installation path
    OPENSSL_ROOT_DIR=$(dirname $(dirname $(which openssl)))
    if [ -z "$OPENSSL_ROOT_DIR" ]; then
        OPENSSL_ROOT_DIR="/usr"
    fi
    echo "Using OpenSSL from: $OPENSSL_ROOT_DIR"
    
    # Create a temporary directory
    local tmp_dir=$(mktemp -d)
    cd $tmp_dir
    
    # Clone the repository
    git clone https://github.com/nghttp2/nghttp2-asio.git
    check_command_failure "Cloning nghttp2-asio repository"
    cd nghttp2-asio

    # Clean up any previous build artifacts
    if [ -d "build" ]; then
        rm -rf build
    fi
    # Build and install
    mkdir -p build
    cd build
    cmake  ..
    check_command_failure "Configuring nghttp2-asio"
    make -j$(nproc)
    check_command_failure "Building nghttp2-asio"
    # First uninstall any previous version
    $SUDO make uninstall || true
    $SUDO make install
    check_command_failure "Installing nghttp2-asio"
    $SUDO ldconfig
    # Create symlinks if needed
    if [ ! -f "/usr/lib/libnghttp2_asio.so" ] && [ -f "/usr/local/lib/libnghttp2_asio.so" ]; then
        echo "Creating symlinks for nghttp2-asio libraries"
        $SUDO ln -sf /usr/local/lib/libnghttp2_asio.so /usr/lib/libnghttp2_asio.so
    fi
    # Clean up
    cd $THIS_SCRIPT_PATH
    echo "================= Cleaning up temporary directory $tmp_dir"
    rm -rf $tmp_dir
    echo "nghttp2 with ASIO bindings installation complete"
    return 0
}