#!/bin/bash

# Install nlohmann/json from source
install_nlohmann_json_from_git() {
    local force=$1
    local debug=$2
    
    echo "Installing nlohmann/json from source"
    
    # Check if nlohmann/json is already installed
    if [ $force -eq 0 ]; then
        if [ -d "/usr/local/include/nlohmann" ]; then
            echo "nlohmann/json already installed"
            return 0
        fi
    fi
    
    # Create a temporary directory
    local tmp_dir=$(mktemp -d)
    cd $tmp_dir
    
    # Clone the repository
    git clone https://github.com/nlohmann/json.git
    check_command_failure "Cloning nlohmann/json repository"
    
    cd json
    
    # Build and install
    mkdir -p build
    cd build
    
    cmake -DJSON_BuildTests=OFF \
          -DCMAKE_INSTALL_PREFIX=/usr/local \
          ..
    check_command_failure "Configuring nlohmann/json"
    
    make -j$(nproc)
    check_command_failure "Building nlohmann/json"
    
    $SUDO make install
    check_command_failure "Installing nlohmann/json"
    
    # Clean up
    cd $THIS_SCRIPT_PATH
    rm -rf $tmp_dir
    
    echo "nlohmann/json installation complete"
    return 0
}