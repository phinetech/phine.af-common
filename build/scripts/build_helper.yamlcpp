#!/bin/bash

# Install yaml-cpp from source
install_yaml_cpp_from_git() {
    local force=$1
    local debug=$2
    
    echo "Installing yaml-cpp from source"
    
    # Check if yaml-cpp is already installed
    if [ $force -eq 0 ]; then
        if [ -d "/usr/local/include/yaml-cpp" ]; then
            echo "yaml-cpp already installed"
            return 0
        fi
    fi
    
    # Create a temporary directory
    local tmp_dir=$(mktemp -d)
    cd $tmp_dir
    
    # Clone the repository
    git clone https://github.com/jbeder/yaml-cpp.git
    check_command_failure "Cloning yaml-cpp repository"
    
    cd yaml-cpp
    git checkout yaml-cpp-0.7.0
    
    # Build and install
    mkdir -p build
    cd build
    
    cmake -DYAML_BUILD_SHARED_LIBS=ON \
          -DYAML_CPP_BUILD_TESTS=off \
          -DCMAKE_INSTALL_PREFIX=/usr/local \
          ..
    check_command_failure "Configuring yaml-cpp"
    
    make -j$(nproc)
    check_command_failure "Building yaml-cpp"
    
    $SUDO make install
    check_command_failure "Installing yaml-cpp"
    
    $SUDO ldconfig
    
    # Clean up
    cd $THIS_SCRIPT_PATH
    rm -rf $tmp_dir
    
    echo "yaml-cpp installation complete"
    return 0
}